{
  "name": "hermes-browserbench-timeout-validation-deepseek",
  "versions_file": "../../configs/versions.json",
  "overrides_file": "timeout-validation-overrides.json",
  "execution": {
    "concurrency": 1
  },
  "benchmark": {
    "type": "browserbench",
    "root": ".cache/browserbench",
    "tasks": [
      "efc0f3a47e9ed2ecdbcc037c2093865fe6e39f4d413a5d1ccdc7357160a4606b"
    ],
    "environment": {
      "image": "mcr.microsoft.com/playwright/mcp:v0.0.83",
      "workdir": "/home/node"
    }
  },
  "harness": {
    "type": "hermes",
    "deployment": {
      "backend": "docker",
      "docker": {
        "socket": "/var/run/docker.sock"
      }
    }
  },
  "sandbox": {
    "deployment": {
      "backend": "docker",
      "docker": {
        "socket": "/var/run/docker.sock"
      }
    }
  },
  "bridge": {
    "deployment": {
      "backend": "docker"
    },
    "type": "hermes-ssh",
    "mode": "managed"
  },
  "runtime": {
    "backend": "deepseek",
    "mode": "external"
  },
  "model": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "id": "deepseek-flash",
    "reasoning_effort": "low"
  },
  "output_dir": "runs"
}
